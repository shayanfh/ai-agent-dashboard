# Application
APP_NAME=AI Agent Dashboard
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1

# Public hostname and Let's Encrypt account
DOMAIN=api.example.com
LETSENCRYPT_EMAIL=admin@example.com

# Security — generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-in-production-use-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Internal Voice Agent API Key
INTERNAL_API_KEY=change-internal-api-key-in-production

# PostgreSQL
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ai_agent_dashboard

# Redis
REDIS_URL=redis://localhost:6379/0

# Celery
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Credential encryption — generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIAL_ENCRYPTION_KEY=change-me-generate-with-fernet-keygen

# CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# Storage (MinIO / S3)
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_BUCKET=ai-agent-dashboard

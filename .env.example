# Application
APP_NAME=AI Agent Dashboard
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1

# Public hostname and Let's Encrypt account
DOMAIN=api.example.com
LETSENCRYPT_EMAIL=admin@example.com

# Security — generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-in-production-use-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Internal Voice Agent API Key
INTERNAL_API_KEY=change-internal-api-key-in-production

# Authentication lifecycle
EMAIL_VERIFICATION_EXPIRE_HOURS=24
PASSWORD_RESET_EXPIRE_MINUTES=30
TRIAL_DAYS=14
MAX_FAILED_LOGIN_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15

# Email: console or smtp
EMAIL_PROVIDER=console
EMAIL_FROM=no-reply@example.com
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
FRONTEND_URL=http://localhost:5173

# LiveKit SIP provisioning (Backend server-side only)
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_SIP_ENDPOINT=your-project.sip.livekit.cloud
LIVEKIT_AGENT_NAME=ai-agent-dashboard-inbound

# PostgreSQL
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ai_agent_dashboard

# Redis
REDIS_URL=redis://localhost:6379/0

# Celery
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Credential encryption — generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIAL_ENCRYPTION_KEY=change-me-generate-with-fernet-keygen

# CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# Storage (MinIO / S3)
# Used when running the API directly on the host.
STORAGE_ENDPOINT=http://localhost:9000
# Compose defaults to http://minio:9000. Set this only for an external S3 endpoint.
STORAGE_ENDPOINT_DOCKER=
# Browser-reachable HTTPS Nginx origin used in presigned recording download links.
# When omitted in Docker Compose, this defaults to https://${DOMAIN}.
STORAGE_PUBLIC_ENDPOINT=https://api.example.com
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_BUCKET=ai-agent-dashboard
MAX_RECORDING_UPLOAD_BYTES=52428800
RECORDING_PRESIGNED_URL_EXPIRE_SECONDS=900
